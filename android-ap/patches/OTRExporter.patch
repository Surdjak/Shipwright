From 60a7ad669f1a6b333604fae8db2ce599d40fefdd Mon Sep 17 00:00:00 2001
From: n64player <n64player@live.com>
Date: Wed, 11 Nov 2026 17:19:24 +0000
Subject: [PATCH] Android port: link tinyxml2/libzip on Android (from
 Waterdish/OTRExporter)

---
 OTRExporter/CMakeLists.txt | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/OTRExporter/CMakeLists.txt b/OTRExporter/CMakeLists.txt
index 5812d4b..3280374 100644
--- a/OTRExporter/CMakeLists.txt
+++ b/OTRExporter/CMakeLists.txt
@@ -154,6 +154,14 @@ target_link_libraries(${PROJECT_NAME} PUBLIC nlohmann_json::nlohmann_json)
 find_package(spdlog REQUIRED)
 target_link_libraries(${PROJECT_NAME} PUBLIC spdlog::spdlog)
 
+if (CMAKE_SYSTEM_NAME STREQUAL "Android")
+	find_package(tinyxml2 REQUIRED)
+	target_link_libraries(${PROJECT_NAME} PUBLIC tinyxml2::tinyxml2)
+	find_package(libzip REQUIRED)
+	target_link_libraries(libultraship PRIVATE libzip::zip)
+	target_include_directories(${PROJECT_NAME} PUBLIC ${libzip_SOURCE_DIR}/lib ${libzip_BINARY_DIR})
+endif()
+
 FetchContent_Declare(
     StormLib
     GIT_REPOSITORY https://github.com/ladislav-zezula/StormLib.git
-- 
